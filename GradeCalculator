# Simple Grade Checker Program

grade = int(input("Enter your test score (0–100): "))

if grade >= 90:
    print("Excellent! You got an A.")
elif grade >= 80:
    print("Good job! You got a B.")
elif grade >= 70:
    print("You passed with a C.")
elif grade >= 60:
    print("You passed with a D.")
else:
    print("Sorry, you failed the class.")
